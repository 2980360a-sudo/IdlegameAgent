# IdleAgent 环境变量配置模板
# 复制本文件为 .env 并填入真实值（.env 不会被提交到 Git）

# Melvor Idle 云账号（示例格式，请替换为你的真实账号）
MELVOR_ACCOUNT=your_account_here
MELVOR_PASSWORD=your_password_here

# 通用浏览器账号（若使用 GAME_* 变量，Melvor 适配器也会读取）
GAME_ACCOUNT=
GAME_PASSWORD=

# LLM API 配置
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 调度配置
DIAGNOSIS_INTERVAL_MINUTES=60
DECISION_INTERVAL_MINUTES=10
EMERGENCY_CHECK_SECONDS=30

# 浏览器配置
HEADLESS=true
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# 日志与状态
STATE_DIR=./state
LOG_DIR=./logs
SHOT_DIR=./shots
STATE_DB=./state/idleagent.db

# API 是否接入真实适配器（true 时 start 会拉起浏览器）
USE_REAL_ADAPTER=false
